<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/step1Container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¿Qué actividad vamos a añadir?"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1C1C1E"
        android:layout_marginBottom="12dp"
        android:gravity="center"/>

    <GridLayout
        android:id="@+id/gridTipoActividad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="4"
        android:alignmentMode="alignMargins"
        android:layout_marginBottom="16dp">

        <Button android:id="@+id/btnTypeMed" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="Tomar medicina" android:textSize="16sp" android:background="@drawable/bg_tipo_normal" android:layout_margin="4dp" android:textAllCaps="false"/>
        <Button android:id="@+id/btnTypeCom" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="Comer" android:textSize="16sp" android:background="@drawable/bg_tipo_normal" android:layout_margin="4dp" android:textAllCaps="false"/>
        <Button android:id="@+id/btnTypeAgu" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="Beber agua" android:textSize="16sp" android:background="@drawable/bg_tipo_normal" android:layout_margin="4dp" android:textAllCaps="false"/>
        <Button android:id="@+id/btnTypePas" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="Ir a caminar" android:textSize="16sp" android:background="@drawable/bg_tipo_normal" android:layout_margin="4dp" android:textAllCaps="false"/>
        <Button android:id="@+id/btnTypeAse" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="Aseo personal" android:textSize="16sp" android:background="@drawable/bg_tipo_normal" android:layout_margin="4dp" android:textAllCaps="false"/>
        <Button android:id="@+id/btnTypeJue" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="Juegos" android:textSize="16sp" android:background="@drawable/bg_tipo_normal" android:layout_margin="4dp" android:textAllCaps="false"/>
        <Button android:id="@+id/btnTypeFam" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="Llamar a la familia" android:textSize="16sp" android:background="@drawable/bg_tipo_normal" android:layout_margin="4dp" android:textAllCaps="false"/>
        <Button android:id="@+id/btnTypeDor" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="Dormir" android:textSize="16sp" android:background="@drawable/bg_tipo_normal" android:layout_margin="4dp" android:textAllCaps="false"/>
    </GridLayout>

    <Spinner
        android:id="@+id/spinnerTipoActividad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"/>
</LinearLayout>
