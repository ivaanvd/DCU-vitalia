<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="480dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AÑADIR RECORDATORIO"
            android:textSize="@dimen/text_size_large"
            android:textStyle="bold"
            android:textColor="#1C1C1E"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Qué quieres recordar?"
            android:textSize="@dimen/text_size_small"
            android:textStyle="bold"
            android:textColor="#1C1C1E"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etTituloRecordatorio"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:textSize="@dimen/text_size_medium"
            android:textColor="#1C1C1E"
            android:background="@drawable/bg_campo_descripcion"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:inputType="text"
            android:layout_marginBottom="24dp"/>


        <!-- Hora + Fecha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿A qué hora?"
                android:textSize="@dimen/text_size_small"
                android:textColor="#6E6E73"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvHoraDialogRec"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:text="00:00"
                android:textSize="48sp"
                android:textStyle="bold"
                android:textColor="#1C1C1E"
                android:gravity="center"
                android:background="@drawable/bg_campo_descripcion"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Qué día?"
                android:textSize="@dimen/text_size_small"
                android:textColor="#6E6E73"
                android:layout_marginBottom="6dp"/>

            <LinearLayout
                android:id="@+id/tvFechaDialogRec"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_campo_descripcion"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvFechaTexto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="dd/mm/aaaa"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    android:textColor="#1C1C1E"
                    android:gravity="center_vertical"/>

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_calendario"
                    android:contentDescription=""/>
            </LinearLayout>
        </LinearLayout>

        <!-- Anticipación -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Avisarme con antelación"
            android:textSize="@dimen/text_size_small"
            android:textColor="#6E6E73"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="32dp">

            <TextView
                android:id="@+id/btnAnticipacionMenos"
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:text="−"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:gravity="center"
                android:background="@drawable/bg_tipo_normal"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tvAnticipacionValor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="10 minutos antes"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                android:textColor="#1C1C1E"
                android:gravity="center"/>

            <TextView
                android:id="@+id/btnAnticipacionMas"
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:text="+"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:gravity="center"
                android:background="@drawable/bg_tipo_normal"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelarDialogRec"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="CANCELAR"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_cancelar"
                android:layout_marginEnd="12dp"/>

            <Button
                android:id="@+id/btnGuardarDialogRec"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="AÑADIR"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_guardar"/>
        </LinearLayout>

    </LinearLayout>

    <!-- X dentro de la tarjeta -->
    <TextView
        android:id="@+id/btnCerrarDialogRec"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:text="✕"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#1C1C1E"
        android:gravity="center"
        android:background="@drawable/bg_tipo_normal"
        android:clickable="true"
        android:focusable="true"/>

</FrameLayout>