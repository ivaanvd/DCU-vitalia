<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0EEE8">

    <include layout="@layout/include_top_back_banner" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <!-- SECCIÓN PERFIL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="2dp"
            android:text="PERFIL Y CUENTA"
            android:textColor="#888888"
            android:textSize="@dimen/text_size_small"
            android:letterSpacing="0.12"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_ajuste_mockup_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    xmlns:app="http://schemas.android.com/apk/res-auto"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:id="@+id/ivAvatarAjustes"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_avatar_circle" />
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nombre de usuario"
                        android:textSize="14sp"
                        android:textColor="#888888" />

                    <EditText
                        android:id="@+id/etNombreAjustes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_edittext_ajustes"
                        android:hint="Tu nombre"
                        android:inputType="textPersonName"
                        android:textColor="#1A1A1A"
                        android:textSize="@dimen/text_size_medium"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnCambiarFotoCamara"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Cámara"
                    android:textSize="@dimen/text_size_small"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_tipo_normal" />

                <Button
                    android:id="@+id/btnCambiarFotoGaleria"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Galería"
                    android:textSize="@dimen/text_size_small"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_tipo_normal" />
            </LinearLayout>

            <Button
                android:id="@+id/btnBorrarCuenta"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="Borrar cuenta y datos"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_tipo_incorrecto"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- SECCIÓN VOLUMEN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="2dp"
            android:text="VOLUMEN"
            android:textColor="#888888"
            android:textSize="@dimen/text_size_small"
            android:letterSpacing="0.12"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_ajuste_mockup_card">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Volumen del robot"
                android:textSize="@dimen/text_size_small"
                android:textStyle="normal"
                android:textColor="#1A1A1A" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnMenosVolumen"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="−"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:background="@drawable/bg_stepper_btn" />

                <EditText
                    android:id="@+id/etVolumen"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_edittext_ajustes"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="3"
                    android:text="70"
                    android:textColor="#1A1A1A"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnMasVolumen"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="+"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:background="@drawable/bg_stepper_btn" />
            </LinearLayout>
        </LinearLayout>

        <!-- SECCIÓN BRILLO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="2dp"
            android:text="BRILLO"
            android:textColor="#888888"
            android:textSize="@dimen/text_size_small"
            android:letterSpacing="0.12"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_ajuste_mockup_card">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Brillo de la pantalla"
                android:textSize="@dimen/text_size_small"
                android:textStyle="normal"
                android:textColor="#1A1A1A" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnMenosBrillo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="−"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:background="@drawable/bg_stepper_btn" />

                <EditText
                    android:id="@+id/etBrillo"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_edittext_ajustes"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="3"
                    android:text="60"
                    android:textColor="#1A1A1A"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnMasBrillo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="+"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:background="@drawable/bg_stepper_btn" />
            </LinearLayout>
        </LinearLayout>

        <!-- Botón GUARDAR -->
        <Button
            android:id="@+id/btnGuardarAjustes"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="GUARDAR CAMBIOS"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:background="@drawable/bg_tipo_correcto"
            android:textAllCaps="true" />

    </LinearLayout>
</LinearLayout>