<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- SECCIÓN: NOMBRE -->

        <!-- BOCADILLO DEL ROBOT (Mejora Área 2) -->
        <include layout="@layout/include_robot_bocadillo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"/>

        <!-- SECCIÓN: NOMBRE -->
        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:hint="Escribe tu nombre"
            android:textSize="@dimen/text_size_medium"
            android:textColor="#1C1C1E"
            android:textColorHint="#A0A0A0"
            android:inputType="textPersonName|textCapWords"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_input_welcome"
            android:layout_marginBottom="16dp"/>

        <!-- Botón de micrófono para dictar nombre -->
        <LinearLayout
            android:id="@+id/containerMicWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btnMicWelcome"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:src="@drawable/ic_microfono"
                android:background="@drawable/bg_fab_mic"
                android:scaleType="centerInside"
                android:padding="20dp"
                android:layout_marginBottom="8dp"
                android:contentDescription="Pulsa para decir tu nombre"
                android:elevation="4dp"/>

            <TextView
                android:id="@+id/tvEstadoMicWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PULSA AQUÍ Y DIME TU NOMBRE"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/mic_normal"
                android:gravity="center"/>
        </LinearLayout>

        <!-- SECCIÓN: FOTO (Avatar arriba, Botones abajo horizontalmente) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="32dp">

            <!-- Avatar centrado -->
            <ImageView
                android:id="@+id/ivFoto"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:src="@drawable/ic_persona"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_avatar_circle"
                android:contentDescription="Vista previa de foto de perfil"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="24dp"/>

            <!-- Botones horizontales abajo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnCapturarFoto"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:text="USAR CÁMARA"
                    android:textSize="16sp"
                    android:textColor="#111111"
                    android:background="@drawable/bg_tipo_normal"
                    android:textAllCaps="false"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnSeleccionarGaleria"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:text="DE LA GALERÍA"
                    android:textSize="16sp"
                    android:textColor="#111111"
                    android:background="@drawable/bg_tipo_normal"
                    android:textAllCaps="false"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Botón guardar -->
        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="COMENZAR"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_tipo_correcto"
            android:textAllCaps="true"/>

    </LinearLayout>

</ScrollView>
