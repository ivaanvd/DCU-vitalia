<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Título de bienvenida -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¡Bienvenido!"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#1C1C1E"
            android:textAlignment="center"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configura tu perfil para empezar"
            android:textSize="16sp"
            android:textColor="#6E6E73"
            android:textAlignment="center"
            android:layout_marginBottom="16dp"/>

        <!-- SECCIÓN: NOMBRE -->
        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Escribe tu nombre"
            android:textSize="16sp"
            android:textColor="#1C1C1E"
            android:textColorHint="#A0A0A0"
            android:inputType="textPersonName|textCapWords"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_input_welcome"
            android:layout_marginBottom="16dp"/>

        <!-- SECCIÓN: FOTO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Foto de perfil"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1C1C1E"
            android:layout_marginBottom="12dp"
            android:layout_gravity="center_horizontal"/>

        <!-- Preview de la foto -->
        <ImageView
            android:id="@+id/ivFoto"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/ic_persona"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_avatar_circle"
            android:layout_gravity="center_horizontal"
            android:contentDescription="Vista previa de foto de perfil"
            android:layout_marginBottom="16dp"/>

        <!-- Botones para foto (Horizontal) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnCapturarFoto"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Cámara"
                android:textSize="14sp"
                android:textColor="#111111"
                android:background="@drawable/bg_tipo_normal"
                android:textAllCaps="false"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnSeleccionarGaleria"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Galería"
                android:textSize="14sp"
                android:textColor="#111111"
                android:background="@drawable/bg_tipo_normal"
                android:textAllCaps="false"/>
        </LinearLayout>

        <!-- Botón guardar -->
        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="COMENZAR"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_tipo_correcto"
            android:textAllCaps="true"/>

    </LinearLayout>

</ScrollView>
