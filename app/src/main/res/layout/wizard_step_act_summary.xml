<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/summaryContainerAct"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone"
    android:gravity="center"
    android:layout_marginBottom="24dp">
    
    <!-- Círculo con icono -->
    <FrameLayout
        android:id="@+id/frameEmojiSummaryAct"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_icon_circle_white">
        <ImageView
            android:id="@+id/ivIconSummaryAct"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_puzzle"
            android:contentDescription=""/>
    </FrameLayout>

    <TextView
        android:id="@+id/tvSummaryHoraAct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="11:35"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="#1C1C1E"
        android:layout_marginBottom="2dp"/>

    <TextView
        android:id="@+id/tvSummaryTipoAct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JUEGOS"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#1C1C1E"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_field_active"
        android:padding="16dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DETALLES:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#8E8E93"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvSummaryDescAct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#3C3C43"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DÍAS PROGRAMADOS:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#8E8E93"
            android:layout_marginBottom="8dp"/>

        <!-- Contenedor dinámico de días (pills) -->
        <LinearLayout
            android:id="@+id/containerDiasSummaryAct"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"/>
    </LinearLayout>

</LinearLayout>
